<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutNotificationRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Circular Type Icon (40dp x 40dp) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgTypeIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="9dp"
        android:src="@drawable/ic_museum"
        app:tint="@color/white"
        android:background="@color/primary_dark"
        android:contentDescription="@string/app_name"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvNotifTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:textColor="@color/dark_blue"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Nuevo curso disponible"
        app:layout_constraintStart_toEndOf="@id/imgTypeIcon"
        app:layout_constraintEnd_toStartOf="@id/tvTimestamp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Message Body -->
    <TextView
        android:id="@+id/tvNotifMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="Curso de Museología Digital"
        app:layout_constraintStart_toEndOf="@id/imgTypeIcon"
        app:layout_constraintEnd_toStartOf="@id/vUnreadDot"
        app:layout_constraintTop_toBottomOf="@id/tvNotifTitle"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Timestamp -->
    <TextView
        android:id="@+id/tvTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="10 min"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Unread Blue Dot Indicator -->
    <View
        android:id="@+id/vUnreadDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/ic_check_circle"
        android:backgroundTint="@color/primary"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTimestamp" />

    <!-- Subtle Bottom Divider Line -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/divider_color"
        app:layout_constraintTop_toBottomOf="@id/tvNotifMessage"
        app:layout_constraintStart_toStartOf="@id/tvNotifTitle"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>