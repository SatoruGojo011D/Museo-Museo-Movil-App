<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.VirtualMuseumsMapFragment">

    <!-- OpenStreetMap base layer; no API key is required. -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/mapControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/cardMuseumInfo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollViewFilters">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZoomIn"
            style="@style/Widget.Material3.Button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/map_zoom_in"
            android:text="+"
            android:textSize="22sp"
            app:backgroundTint="@color/surface_card" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZoomOut"
            style="@style/Widget.Material3.Button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/map_zoom_out"
            android:text="−"
            android:textSize="22sp"
            app:backgroundTint="@color/surface_card" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCenterChile"
            style="@style/Widget.Material3.Button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/map_center_chile"
            android:text="CL"
            android:textSize="14sp"
            app:backgroundTint="@color/surface_card" />
    </LinearLayout>

    <!-- 2. Top Filter Bar (Overlaid on Map) -->
    <HorizontalScrollView
        android:id="@+id/scrollViewFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodos"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/map_filter_all"
                app:chipBackgroundColor="@color/surface_card"
                app:chipStrokeColor="@color/beige_gold"
                app:chipStrokeWidth="1.5dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipProject"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_filter_project"
                app:chipBackgroundColor="@color/surface_card"
                app:chipStrokeColor="@color/divider_color"
                app:chipStrokeWidth="1dp" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- 3. Bottom Floating Info Card (Overlaid on Map) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMuseumInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/surface_card"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- Museum Thumbnail Image -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgMuseumThumb"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_museum_interior"
                android:contentDescription="@string/app_name"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Title -->
            <TextView
                android:id="@+id/tvMuseumTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:textColor="@color/dark_blue"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Museo Nacional\nde Arte Colonial"
                app:layout_constraintStart_toEndOf="@id/imgMuseumThumb"
                app:layout_constraintEnd_toStartOf="@id/btnMuseumDetail"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Location -->
            <TextView
                android:id="@+id/tvMuseumLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:drawableStartCompat="@drawable/ic_location_pin"
                android:drawablePadding="4dp"
                tools:text="Bogotá, Colombia"
                app:layout_constraintStart_toEndOf="@id/imgMuseumThumb"
                app:layout_constraintEnd_toStartOf="@id/btnMuseumDetail"
                app:layout_constraintTop_toBottomOf="@id/tvMuseumTitle" />

            <!-- Tags Container -->
            <LinearLayout
                android:id="@+id/layoutTags"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                app:layout_constraintStart_toEndOf="@id/imgMuseumThumb"
                app:layout_constraintEnd_toStartOf="@id/btnMuseumDetail"
                app:layout_constraintTop_toBottomOf="@id/tvMuseumLocation">

                <TextView
                    android:id="@+id/tvTag1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_tag_rounded"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    tools:text="Historia" />

                <TextView
                    android:id="@+id/tvTag2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/dark_blue"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_tag_teal_rounded"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    tools:text="Virtual" />

            </LinearLayout>

            <!-- Rating Row -->
            <LinearLayout
                android:id="@+id/layoutRating"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintStart_toEndOf="@id/imgMuseumThumb"
                app:layout_constraintTop_toBottomOf="@id/layoutTags">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_star"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvRatingScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="4.8" />

                <TextView
                    android:id="@+id/tvRatingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="(120)" />

            </LinearLayout>

            <!-- Action Arrow Button (>) -->
            <ImageView
                android:id="@+id/btnMuseumDetail"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/dark_blue"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_view_detail"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>