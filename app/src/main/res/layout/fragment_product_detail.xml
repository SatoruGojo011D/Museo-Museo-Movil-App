<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_warm"
    tools:context=".ui.fragments.ProductDetailFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="36dp">

        <!-- 1. Hero Image Area (Height ~260dp) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgProductHero"
            android:layout_width="0dp"
            android:layout_height="260dp"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_museum_interior"
            android:contentDescription="@string/app_name"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Overlaid Controls: Back Button Top Left -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white"
            android:background="@drawable/bg_circle_translucent"
            android:contentDescription="@string/register_back_desc"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Overlaid Controls: Favorite Toggle Button Top Right -->
        <ImageView
            android:id="@+id/btnFavoriteHeader"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="24dp"
            android:padding="8dp"
            android:src="@drawable/ic_favorite_border"
            app:tint="@color/white"
            android:background="@drawable/bg_circle_translucent"
            android:contentDescription="@string/btn_save_favorites"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 2. Content Container Below Hero Image -->

        <!-- Title -->
        <TextView
            android:id="@+id/tvProductTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="24dp"
            android:textColor="@color/dark_blue"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Historia del Arte\nIberoamericano"
            app:layout_constraintTop_toBottomOf="@id/imgProductHero"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Price -->
        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="24dp"
            android:textColor="@color/dark_blue"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="US$ 35"
            app:layout_constraintTop_toBottomOf="@id/tvProductTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Rating Row: 4 Star icons + rating score -->
        <LinearLayout
            android:id="@+id/layoutRating"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/tvPrice"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="2dp"
                android:src="@drawable/ic_star"
                android:contentDescription="@null" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="2dp"
                android:src="@drawable/ic_star"
                android:contentDescription="@null" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="2dp"
                android:src="@drawable/ic_star"
                android:contentDescription="@null" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_star"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvRatingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="4.7 (58 reseñas)" />

        </LinearLayout>

        <!-- Description Paragraph -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="24dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.2"
            tools:text="Un recorrido completo por el desarrollo del arte en Iberoamérica, con análisis de obras, contextos históricos y perspectivas contemporáneas."
            app:layout_constraintTop_toBottomOf="@id/layoutRating"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 3. Quantity & Availability Row -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutQuantityAvailability"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvDescription"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Left Side: Quantity Stepper -->
            <LinearLayout
                android:id="@+id/layoutQuantityStepper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/tvQuantityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/product_detail_quantity_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Stepper Pills Container -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/containerStepper"
                    android:layout_width="120dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider_color"
                    app:strokeWidth="1.5dp"
                    app:cardBackgroundColor="@color/surface_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/btnMinus"
                            android:layout_width="32dp"
                            android:layout_height="match_parent"
                            android:padding="6dp"
                            android:src="@drawable/ic_remove"
                            app:tint="@color/dark_blue"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/stepper_minus_desc" />

                        <TextView
                            android:id="@+id/tvQuantity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            tools:text="1" />

                        <ImageView
                            android:id="@+id/btnPlus"
                            android:layout_width="32dp"
                            android:layout_height="match_parent"
                            android:padding="6dp"
                            android:src="@drawable/ic_add"
                            app:tint="@color/dark_blue"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/stepper_plus_desc" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Right Side: Availability Indicator -->
            <LinearLayout
                android:id="@+id/layoutAvailability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/tvAvailabilityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/product_detail_availability_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Green Status Dot + "En stock" -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/vStatusDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/ic_check_circle"
                        android:backgroundTint="@color/green_success" />

                    <TextView
                        android:id="@+id/tvStockStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/product_detail_in_stock"
                        android:textColor="@color/green_success"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 4. Primary Action Button: "Agregar al carrito" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToCart"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="20dp"
            android:text="@string/btn_add_to_cart"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/beige_gold"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_cart"
            app:iconTint="@color/black"
            app:iconGravity="textStart"
            app:layout_constraintTop_toBottomOf="@id/layoutQuantityAvailability"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>